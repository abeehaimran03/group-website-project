.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 2px solid #ddd;
}

.page-header h1 {
    margin: 0;
    font-size: 2.2rem;
}

.page-nav ul {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
}

.page-nav a {
    text-decoration: none;
    color: #004400;
    font-weight: bold;
    font-size: 1rem;
}

.container-section {
    display: flex;
    align-items: flex-start;
    margin: 40px 0;
    gap: 30px;
}

.container-content {
    flex: 2;
}

.an-image {
    flex: 1;
    text-align: right;
}

.an-image img {
    width: 100%;
    max-width: 250px;
    border-radius: 6px;
}

.image-caption {
    text-align: center;
    font-size: 0.9rem;
    margin-bottom: 8px;
}

footer {
  text-align: center;
  background-color: #fdcfcf;
  color: #004400;
  padding: 15px 0;
  margin-top: 40px;
}
